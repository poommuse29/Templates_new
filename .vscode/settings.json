{
    // ตั้งค่า file association ให้ .html เป็น django-html เพื่อให้มีสีไฮไลต์ Syntax Django
    "files.associations": {
        "*.html": "django-html"
    },

    // เปิด format on save
    "editor.formatOnSave": true,

    // ใช้ตัวจัดฟอร์แมต djLint สำหรับ django-html
    "[django-html]": {
        "editor.defaultFormatter": "monosans.djlint",
        "editor.formatOnSave": true
    },

    // ตั้งค่าการทำงานของ djLint
    "djlint.executablePath": "d:\\Progamming\\Django\\template\\env\\Scripts\\djlint.exe",
    "djlint.useVenv": false,

    // เปิดใช้งาน Emmet ในไฟล์ django-html
    "emmet.includeLanguages": {
        "django-html": "html"
    },



    // Python settings
    "python.defaultInterpreterPath": "d:\\Progamming\\Django\\template\\env\\Scripts\\python.exe",

    // ตั้งค่า Pylance ให้หา Django module เจอ
    "python.analysis.extraPaths": [
        "d:\\Progamming\\Django\\template"
    ],
    "python.analysis.diagnosticSeverityOverrides": {
        "reportMissingModuleSource": "none"
    }
}